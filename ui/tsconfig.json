{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "types": ["vite/client"]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/test",
        "src/**/*.test.tsx",
        "src/**/*.test.ts",
        "src/babylon/MQTTDigitalTwinService.ts",
        "src/components/StationFlowDiagram.tsx",
        "src/components/twin/FuelDigitalTwin.tsx",
        "src/hooks/useMqttTwin.ts",
        "src/lib/mqttClient.ts",
        "src/pages/PumpsPage.tsx",
        "src/pages/ReconciliationPage.tsx",
        "src/pages/StationTwinPage.tsx"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
