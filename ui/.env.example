# Same-origin FastAPI (devices, sales, SSE) via Vite/nginx proxy.
# Must end with /api and must NOT have a trailing slash after that.
VITE_API_BASE_URL=/api

# Local FastAPI for auth / admin / twin catalog (empty = same-origin).
VITE_APP_API_BASE_URL=

# Optional: override the Vite proxy target (default localhost:8000).
# VITE_DEV_API_TARGET=http://localhost:8000

VITE_USE_MOCK_DATA=false
