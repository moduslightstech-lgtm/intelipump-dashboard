# Intelipump PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fuelops
POSTGRES_USER=fuelops
POSTGRES_PASSWORD=your_secure_db_password

# Intelipump MQTT Infrastructure
MQTT_HOST=your_mqtt_broker_domain_or_ip
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=intelipump/#

# Application Parameters
JWT_SECRET=specify_a_secure_jwt_token_at_least_32_characters_long
SEED_AUTO_RUN=false
STATION_OFFLINE_THRESHOLD_SECONDS=300
PUMP_OFFLINE_THRESHOLD_SECONDS=300

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
