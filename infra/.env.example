POSTGRES_DB=fuelops
POSTGRES_USER=fuelops
POSTGRES_PASSWORD=fuelops_secret
JWT_SECRET=fuelops-super-secret-jwt-key-at-least-32-chars
SEED_AUTO_RUN=true

# Simulator tuning (optional)
DISPENSE_RATE_PER_SEC=0.3
TANK_READING_INTERVAL_SEC=30
GAP_PROBABILITY=0.05
GAP_DURATION_SEC=20
POS_DELAY_PROBABILITY=0.2
