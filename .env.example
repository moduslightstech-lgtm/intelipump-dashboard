# MQTT (DigitalOcean Mosquitto)
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=intelipump/#
MQTT_QOS=1

# PostgreSQL — never expose port 5432 to the browser
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intelipump
POSTGRES_USER=
POSTGRES_PASSWORD=

# Consumer connection pool
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# API (FastAPI in ./backend)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_TIMEZONE=Africa/Lagos

# CORS — include the public HTTPS origin in production
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://app.intellixxx.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.intellixxx.com

# Public dashboard hostname (Let's Encrypt / enable-https.sh)
PUBLIC_HOST=app.intellixxx.com
LETSENCRYPT_EMAIL=
# Edge device availability thresholds (seconds)
DEVICE_OFFLINE_SECONDS=180
EDGE_ONLINE_SECONDS=90
EDGE_DELAYED_SECONDS=180
EDGE_PUMP_ACTIVE_SECONDS=600
EDGE_NO_SERIAL_SECONDS=1800
EDGE_MONITOR_INTERVAL_SECONDS=60

# Docker Hub images used by compose (droplet pulls these)
DOCKERHUB_NAMESPACE=kacytunde
IMAGE_TAG=latest

# Dashboard image is baked same-origin at build time (/api). Do not set a droplet IP.

# Local FastAPI for auth/admin/twin (empty = same-origin)
# VITE_APP_API_BASE_URL=
VITE_USE_MOCK_DATA=false

# Alert email (optional — leave unset to skip sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
